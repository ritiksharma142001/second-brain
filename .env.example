# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/secondbrain"

# --- Auth (generate with: openssl rand -base64 32) ---
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Public site URL (used for links, sitemap, RSS, OpenGraph) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional: Google sign-in (leave empty to hide the button) ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# --- Optional: seeding ---
# Password for the seeded admin@example.com / user@example.com accounts
ADMIN_PASSWORD=""

# --- Uploaded images ---
# Folder on disk where images are stored (default: ./uploads). In production, point this at a
# persistent volume so uploads survive restarts and redeploys.
UPLOAD_DIR=""

# --- Email (password-reset links) ---
# Any SMTP service works. Resend example: host smtp.resend.com, port 465, user "resend",
# password = your Resend API key. With these empty, development prints the reset link in the
# server console instead of emailing it; production needs them set.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Second Brain <noreply@yourdomain.com>"
